# Local Next.js (Postgres in Docker):
DATABASE_URL=postgres://cnpaf:cnpaf@localhost:5432/cnpaf

# Full stack in Docker uses postgres://cnpaf:cnpaf@postgres:5432/cnpaf automatically.

AUTH_SECRET=replace-with-a-long-random-string
SEED_PASSWORD=cnpaf-dev-change-me
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# local = laptop disk; s3 = AWS object storage (cloud)
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=us-west-2
S3_PREFIX=cnpaf
# Optional: MinIO / S3-compatible endpoint, e.g. http://127.0.0.1:9000
S3_ENDPOINT=
