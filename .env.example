# Local Next.js (Postgres in Docker). URL-encode special password characters.
CNPAF_DB_USER=cnpaf
CNPAF_DB_PASSWORD=replace-with-a-unique-local-password
CNPAF_DB_NAME=cnpaf
DATABASE_URL=postgres://cnpaf:replace-with-a-unique-local-password@localhost:5432/cnpaf
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
INSIGHT_LIVE_REFRESH_MS=30000

# Task notifications and recurrence. Keep Gmail disabled until Workspace
# domain-wide delegation is approved. Store private keys only in ignored env files.
NOTIFICATION_EMAIL_PROVIDER=disabled
GMAIL_API_BASE_URL=https://gmail.googleapis.com/gmail/v1
GMAIL_OAUTH_SCOPE=https://www.googleapis.com/auth/gmail.send
NOTIFICATION_EMAIL_ALLOWED_DOMAINS=cnpaf.org
GMAIL_DELEGATED_SENDER=notifications@cnpaf.org
GMAIL_FROM_NAME=CNPAF Community
# Prefer a mounted credential file locally and in managed runtimes. Alternatively,
# leave this blank and provide both inline values below through a secrets manager.
GMAIL_SERVICE_ACCOUNT_CREDENTIALS_FILE=
GMAIL_SERVICE_ACCOUNT_CLIENT_EMAIL=
GMAIL_SERVICE_ACCOUNT_PRIVATE_KEY=
TASK_AUTOMATION_SECRET=
TASK_RECURRENCE_LOOKAHEAD_DAYS=7

# Full-stack Docker composes DATABASE_URL from the CNPAF_DB_* values.

# Optional local-only demo provisioning. Keep both empty by default.
# SEED_PASSWORD creates the documented CNPAF role + USC student account catalog.
SEED_PASSWORD=
# Or pass a custom organization, 12+ character password, and user rows.
SEED_DEMO_USERS_JSON=
OPENAI_API_KEY=
# Optional: set to local_heuristic to force local analysis even when a key exists.
# With OPENAI_API_KEY present and AI_PROVIDER unset, seed publishes OpenAI-backed workflows.
AI_PROVIDER=
AI_MODEL=gpt-5.4-mini
# Optional approved Responses API gateway override.
OPENAI_BASE_URL=https://api.openai.com/v1/responses
OPENAI_WEB_SEARCH_ENABLED=true
OPENAI_WEB_SEARCH_CONTEXT_SIZE=medium
# local = laptop disk; s3 = AWS object storage (cloud)
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=us-west-2
S3_PREFIX=cnpaf
# Optional: MinIO / S3-compatible endpoint, e.g. http://127.0.0.1:9000
S3_ENDPOINT=
# Usually true for MinIO and false for AWS S3.
S3_FORCE_PATH_STYLE=true
# Optional dual-read compatibility window after cutover. New writes go to S3;
# a missing S3 object is read from this local directory until rollback expires.
STORAGE_FALLBACK_LOCAL_DIR=
# Optional migration-only target overrides. Keep a staging prefix until the
# checksum verification and cutover check both pass.
S3_MIGRATION_BUCKET=
S3_MIGRATION_REGION=
S3_MIGRATION_PREFIX=cnpaf-migration-staging
S3_MIGRATION_ENDPOINT=
STORAGE_MIGRATION_BATCH_SIZE=50
STORAGE_MIGRATION_MANIFEST=.storage-migration/manifest.json
