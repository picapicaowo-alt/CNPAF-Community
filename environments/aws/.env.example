# Set dev or prod. Use a separate file and unique secrets for each environment.
CNPAF_ENV=prod
APP_PORT=3600
INSIGHT_LIVE_REFRESH_MS=30000
CNPAF_DB_PORT=5435
CNPAF_DB_USER=cnpaf
CNPAF_DB_PASSWORD=
CNPAF_DB_NAME=cnpaf
DATABASE_URL=postgres://cnpaf:URL_ENCODED_PASSWORD@127.0.0.1:5435/cnpaf

# Seed only approved accounts. Dev and Prod passwords must be different.
SEED_PASSWORD=
SEED_DEMO_USERS_JSON=

# Prefer an EC2/ECS instance role. Do not add AWS access keys to this file.
STORAGE_BACKEND=s3
S3_BUCKET=
S3_REGION=us-west-2
S3_PREFIX=cnpaf/community/prod
S3_FORCE_PATH_STYLE=false

# Keep only during the approved local-to-S3 rollback window.
STORAGE_FALLBACK_LOCAL_DIR=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Migration uses the same final prefix unless a separately verified copy is planned.
S3_MIGRATION_BUCKET=
S3_MIGRATION_REGION=us-west-2
S3_MIGRATION_PREFIX=cnpaf/community/prod
STORAGE_MIGRATION_BATCH_SIZE=50
STORAGE_MIGRATION_MANIFEST=.storage-migration/manifest.json
